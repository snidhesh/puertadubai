{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(deps)"],
  "schedule": ["before 6am on Monday"],
  "vulnerabilityAlerts": {"enabled": true, "labels": ["security"]},
  "packageRules": [
    {
      "groupName": "Next + React",
      "matchPackageNames": ["next", "react", "react-dom", "@types/react", "@types/react-dom", "eslint-config-next"]
    },
    {
      "groupName": "Sanity ecosystem",
      "matchPackageNames": ["sanity", "@sanity/**", "next-sanity", "sanity-plugin-**"]
    },
    {
      "groupName": "Tailwind + design",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "class-variance-authority", "clsx", "tailwind-merge"]
    },
    {
      "groupName": "Test tooling",
      "matchPackageNames": ["vitest", "@vitest/**", "@playwright/test"]
    }
  ]
}
